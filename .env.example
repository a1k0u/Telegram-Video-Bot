# RU: Токен вашего бота, получите у @BotFather
# EN: Your bot token, get it from @BotFather
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# RU: ID канала, куда можно публиковать кружочки (например: -1001234567890)
# EN: Channel ID where video notes can be posted (example: -1001234567890)
CHANNEL_ID=-1001234567890

# RU: Whitelist Telegram user_id (через запятую). Пусто = разрешены все.
# EN: Whitelist Telegram user_id (comma-separated). Empty = allow everyone.
WHITELIST_USER_IDS=123456789,987654321
